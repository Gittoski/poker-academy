{
  "name": "open-range-viewer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build:ranges": "node scripts/build-ranges.mjs",
    "prebuild": "node scripts/build-ranges.mjs --if-present",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run test:integrity && tsc --noEmit && vitest run",
    "build:hands": "node scripts/generate-hands.mjs",
    "solve:flops": "node scripts/solve-postflop.mjs",
    "test:browser": "playwright test",
    "test:integrity": "node scripts/verification/check-simulator.cjs",
    "test:engine": "vitest run src/lib/engineIntegrity.test.ts src/simulator/engineData.test.ts src/simulator/liveEngine.test.ts src/simulator/liveSession.test.ts src/lib/cards.test.ts src/lib/fullHands.test.ts src/lib/handSim.test.ts src/lib/trainer.test.ts"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
